{
  "name": "rail-yatra-platform",
  "version": "1.1.0",
  "description": "AI-powered Railway Travel Intelligence Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n FRONTEND,BACKEND -c blue,green \"pnpm --filter frontend dev\" \"pnpm --filter backend start:dev\"",
    "build": "pnpm --filter \"*\" build",
    "test": "pnpm --filter \"*\" test",
    "lint": "pnpm --filter \"*\" lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.34.4"
}