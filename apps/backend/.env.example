# Core Backend Configuration (Render + Neon)
PORT=5000
NODE_ENV=production
# Neon Pooled Connection String (for NestJS runtime)
DATABASE_URL="postgres://user:password@ep-pooler-name.eastus2.azure.neon.tech/railyatra_prod?sslmode=require"
# Neon Direct Connection String (for Prisma CLI migrations)
DIRECT_URL="postgres://user:password@ep-direct-name.eastus2.azure.neon.tech/railyatra_prod?sslmode=require"
JWT_SECRET="generate-a-secure-32-character-random-string-jwt-secret"
JWT_REFRESH_SECRET="generate-a-secure-32-character-random-string-refresh-secret"
REDIS_URL="rediss://default:redis_secure_password@upstash-host:6379"
AI_SERVICE_URL="https://railyatra-ai-service.onrender.com"
CORS_ORIGIN="https://railyatra-frontend.vercel.app"

# Optional production pro-account bootstrap.
# Keep the real email/password only in the Render environment; never commit secrets.
ADMIN_EMAIL="your-admin-email@example.com"
ADMIN_PASSWORD="use-a-long-random-password"
ADMIN_PRO_UNLIMITED="false"
