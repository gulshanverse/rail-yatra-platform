generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  phone         String?         @unique
  fullName      String
  passwordHash  String
  avatar        String?
  role          String          @default("USER")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  conversations Conversation[]
  pnrHistory    PnrHistory[]
  savedRoutes   SavedRoute[]
  searches      SearchHistory[]
  subscriptions Subscription[]
  trips         Trip[]
  settings      UserSetting?
}

model UserSetting {
  id            String  @id @default(uuid())
  userId        String  @unique
  theme         String  @default("auto")
  notifications Boolean @default(true)
  accessibility Boolean @default(false)
  voiceMode     Boolean @default(false)
  privacyMode   Boolean @default(false)
  aiPreferences String?
  language      String  @default("en")
  travelPrefs   String?
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trip {
  id          String    @id @default(uuid())
  userId      String
  source      String
  destination String
  journeyDate DateTime
  returnDate  DateTime?
  passengers  String
  journeyType String    @default("direct")
  budget      Decimal?
  status      String    @default("scheduled")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SearchHistory {
  id          String   @id @default(uuid())
  userId      String
  query       String?
  source      String
  destination String
  filters     String?
  timestamp   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedRoute {
  id          String  @id @default(uuid())
  userId      String
  name        String
  source      String
  destination String
  frequency   String?
  reminder    Boolean @default(false)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PnrHistory {
  id           String   @id @default(uuid())
  pnr          String   @unique
  userId       String
  prediction   String?
  actualStatus String   @default("unknown")
  journeyDate  DateTime
  timestamp    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String        @id @default(uuid())
  userId    String
  summary   String?
  context   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String
  tokensUsed     Int?
  timestamp      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String
  tier      String    @default("FREE")
  expiry    DateTime?
  status    String    @default("active")
  credits   Int       @default(3)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(uuid())
  orderId   String   @unique
  userId    String
  gateway   String
  amount    Decimal
  currency  String   @default("INR")
  status    String
  createdAt DateTime @default(now())
}

model Invoice {
  id            String   @id @default(uuid())
  paymentId     String?
  userId        String
  invoiceNumber String   @unique
  pdfUrl        String?
  amount        Decimal
  currency      String   @default("INR")
  status        String   @default("paid")
  createdAt     DateTime @default(now())
}

model UsageLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  timestamp DateTime @default(now())
}

model BillingEvent {
  id        String   @id @default(uuid())
  userId    String
  eventType String
  payload   String
  timestamp DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  category  String   @default("System")
  priority  String   @default("medium")
  read      Boolean  @default(false)
  channel   String
  timestamp DateTime @default(now())
}

model NotificationPreference {
  id               String  @id @default(uuid())
  userId           String  @unique
  emailAlerts      Boolean @default(true)
  smsAlerts        Boolean @default(false)
  pushAlerts       Boolean @default(true)
  whatsappAlerts   Boolean @default(false)
  quietHoursStart  String  @default("22:00")
  quietHoursEnd    String  @default("06:00")
  marketingAlerts  Boolean @default(false)
  digestPreference String  @default("instant")
}

model ReminderSchedule {
  id           String   @id @default(uuid())
  userId       String
  title        String
  description  String
  triggerTime  DateTime
  status       String   @default("pending")
  reminderType String
  metadata     String?
}

model UserInsight {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  timestamp DateTime @default(now())
}

model DeliveryLog {
  id        String   @id @default(uuid())
  userId    String
  channel   String
  status    String
  errorMsg  String?
  timestamp DateTime @default(now())
}

model EngagementScore {
  id            String   @id @default(uuid())
  userId        String   @unique
  score         Int      @default(0)
  lastTriggered DateTime @default(now())
}

model AuditLog {
  id               String   @id @default(uuid())
  actorId          String
  actorEmail       String
  action           String
  requestId        String?
  ipAddress        String?
  userAgent        String?
  affectedResource String?
  actionResult     String   @default("success")
  details          String
  timestamp        DateTime @default(now())
}

model SystemMetric {
  id            String   @id @default(uuid())
  nodeName      String
  status        String
  cpuPercent    Float    @default(0.0)
  memoryBytes   Decimal  @default(0)
  latencyMs     Int      @default(0)
  cacheHitRatio Float    @default(1.0)
  queueLength   Int      @default(0)
  timestamp     DateTime @default(now())
}

model PlatformEvent {
  id        String   @id @default(uuid())
  type      String
  details   String?
  timestamp DateTime @default(now())
}

model AnalyticsSnapshot {
  id               String   @id @default(uuid())
  date             String   @unique
  activeUsersCount Int      @default(0)
  aiMessagesCount  Int      @default(0)
  analysesCount    Int      @default(0)
  revenueAmount    Decimal  @default(0)
  retentionRate    Float    @default(100.0)
  conversionRatio  Float    @default(0.0)
  timestamp        DateTime @default(now())
}

model FeatureFlag {
  id          String   @id @default(uuid())
  name        String   @unique
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
}

model SystemConfiguration {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
